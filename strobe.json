{
  "build": { "command": "bun run build", "cwd": "packages/app", "output": "packages/app/dist" },
  "serve": { "command": "bun e2e/utils/serve.ts --host 127.0.0.1 --port {port}", "cwd": "packages/app" },
  "apps": {
    "wormagent": {
      "exe": {
        "windows": "%LOCALAPPDATA%/Programs/ai.wormagent.desktop/WormAgent.exe",
        "macos": "/Applications/WormAgent.app/Contents/MacOS/WormAgent"
      },
      "unset": ["WORMAGENT_*", "OTEL_*", "SENTRY_*"],
      "env": {
        "WORMAGENT_DB": "{home}/.local/share/wormagent/wormagent.db",
        "WORMAGENT_CONFIG_DIR": "{home}/.config/wormagent",
        "HTTP_PROXY": "http://127.0.0.1:9",
        "HTTPS_PROXY": "http://127.0.0.1:9",
        "NO_PROXY": "localhost,127.0.0.1,::1"
      },
      "dirs": [".local/share/wormagent"],
      "files": {
        ".config/wormagent/service.json": { "port": "{port}" },
        "AppData/Local/@wormagentdesktop-updater": "a file, not a folder: the updater cannot stage a download while strobe measures"
      },
      "guard": [{ "file": "~/.local/state/wormagent/service.json", "pid": "pid", "url": "url" }],
      "protocols": ["wormagent"]
    },
    "wormagent-beta": {
      "extends": "wormagent",
      "exe": {
        "windows": "%LOCALAPPDATA%/Programs/ai.wormagent.desktop.beta/WormAgent Beta.exe",
        "macos": "/Applications/WormAgent Beta.app/Contents/MacOS/WormAgent Beta"
      }
    }
  }
}
