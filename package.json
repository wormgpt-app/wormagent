{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "wormagent",
  "description": "🌀 WormAgent — Your personal AI agent on your devices & channels · Official agent of WormGPT · wormagent.net",
  "version": "2.4.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.12.3",
  "scripts": {
    "dev": "node server.js",
    "dev:live": "sh -c 'WORMAGENT_TUI_CHANNEL=dev WORMAGENT_PASSWORD=\"$(wormagent service get password)\" exec bun run dev \"$@\" --server \"$(wormagent service status)\"' --",
    "dev:vite": "bun run --cwd packages/cli --conditions=browser dev/vite.ts",
    "dev:vite:live": "sh -c 'WORMAGENT_TUI_CHANNEL=dev WORMAGENT_PASSWORD=\"$(wormagent service get password)\" exec bun run dev:vite \"$@\" --server \"$(wormagent service status)\"' --",
    "dev:desktop": "bun --cwd packages/desktop dev",
    "dev:web": "bun --cwd packages/app dev",
    "dev:site": "bun run --cwd services/site dev",
    "lint": "oxlint && ast-grep scan -c script/ast-grep/gui-plugins/sgconfig.yml && ast-grep scan --rule script/ast-grep/dialog-size.yml packages && bun script/sdk-docs.ts && bun script/check-greys.ts",
    "lint:changed": "bun script/lint-changed.ts",
    "lint:effect-patterns": "ast-grep scan -c script/ast-grep/sgconfig.yml packages/util/src packages/core/src packages/server/src packages/protocol/src packages/cli/src",
    "lint:effect-simplifications": "ast-grep scan -c script/ast-grep/effect-simplifications/sgconfig.yml --off=unused-suppression packages",
    "test:lint-rules": "ast-grep test -c script/ast-grep/sgconfig.yml",
    "test:effect-simplification-rules": "ast-grep test -c script/ast-grep/effect-simplifications/sgconfig.yml",
    "typecheck": "bun turbo typecheck --concurrency=3",
    "typecheck:tsc": "bun turbo typecheck:tsc --concurrency=3",
    "check": "bun run lint && bun run typecheck",
    "typecheck:profile": "bun script/profile-typecheck.ts",
    "typecheck:profile:packages": "bun script/profile-typecheck-packages.ts",
    "pack": "bun run script/pack.ts",
    "upgrade-opentui": "bun run script/upgrade-opentui.ts",
    "postinstall": "bun run --cwd packages/core fix-node-pty",
    "prepare": "husky",
    "random": "echo 'Random script'",
    "sso": "aws sso login --sso-session=wormagent --no-browser",
    "test": "echo 'do not run tests from root' && exit 1",
    "build": "echo \"✅ Hostinger build\" && mkdir -p dist && cp -r public/* dist/ 2>/dev/null || true && ls -lh dist/",
    "build:site": "bun run --cwd services/site build",
    "start": "node server.js"
  },
  "workspaces": {
    "packages": []
  },
  "devDependencies": {
    "@ast-grep/cli": "0.44.0",
    "@hona/strobe": "4.1.0",
    "@oxlint/plugins": "1.93.0",
    "@tsconfig/bun": "4.1.0",
    "@types/bun": "4.1.0",
    "@types/mime-types": "3.0.1",
    "@types/react": "19.2.17",
    "@typescript/native": "4.1.0",
    "glob": "13.0.5",
    "husky": "9.1.7",
    "oxlint": "1.93.0",
    "prettier": "3.6.2",
    "semver": "^7.6.0",
    "turbo": "2.10.2"
  },
  "dependencies": {
    "express": "^4.18.2",
    "compression": "^1.7.4"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/wormgpt-app/wormagent.git"
  },
  "license": "MIT",
  "prettier": {
    "semi": false,
    "printWidth": 120
  },
  "trustedDependencies": [
    "esbuild",
    "node-pty",
    "protobufjs",
    "electron"
  ],
  "overrides": {
    "@opentui/core": "4.1.0",
    "@opentui/keymap": "4.1.0",
    "@opentui/solid": "4.1.0",
    "@effect/platform-node-shared": "4.1.0",
    "@types/bun": "4.1.0",
    "@types/node": "4.1.0",
    "bun-types": "1.4.4",
    "effect": "4.1.0",
    "open": "11.0.4",
    "solid-js": "4.1.0"
  },
  "patchedDependencies": {
    "@ai-sdk/openai-compatible@2.0.41": "patches/@ai-sdk%2Fopenai-compatible@2.0.41.patch",
    "@dnd-kit/dom@0.5.0": "patches/@dnd-kit%2Fdom@0.5.0.patch",
    "@npmcli/agent@4.0.2": "patches/@npmcli%2Fagent@4.0.2.patch",
    "@silvia-odwyer/photon-node@0.3.4": "patches/@silvia-odwyer%2Fphoton-node@0.3.4.patch",
    "@standard-community/standard-openapi@0.2.9": "patches/@standard-community%2Fstandard-openapi@0.2.9.patch",
    "solid-js@1.9.17": "patches/solid-js@1.9.17.patch",
    "@ai-sdk/mistral@3.0.51": "patches/@ai-sdk%2Fmistral@3.0.51.patch",
    "gcp-metadata@8.1.2": "patches/gcp-metadata@8.1.2.patch",
    "pacote@21.5.1": "patches/pacote@21.5.1.patch",
    "@ai-sdk/google@3.0.73": "patches/@ai-sdk%2Fgoogle@3.0.73.patch",
    "@tanstack/virtual-core@3.17.8": "patches/@tanstack%2Fvirtual-core@3.17.8.patch",
    "@ff-labs/fff-bun@0.10.5": "patches/@ff-labs%2Ffff-bun@0.10.5.patch",
    "vite@8.2.4": "patches/vite@8.2.4.patch",
    "@corvu/drawer@0.2.4": "patches/@corvu%2Fdrawer@0.2.4.patch",
    "app-builder-lib@26.15.7": "patches/app-builder-lib@26.15.7.patch",
    "electron-updater@6.8.9": "patches/electron-updater@6.8.9.patch",
    "@pierre/trees@1.0.0-beta.6": "patches/@pierre%2Ftrees@1.0.0-beta.6.patch",
    "@brendonovich/vite-plugin-wormagent@0.1.3": "patches/@brendonovich%2Fvite-plugin-wormagent@0.1.3.patch",
    "@modelcontextprotocol/client@2.4.0": "patches/@modelcontextprotocol%2Fclient@2.4.0.patch",
    "@kobalte/core@0.13.13": "patches/@kobalte%2Fcore@0.13.13.patch"
  },
  "homepage": "https://wormagent.net",
  "author": "wormgpt-app <admin@wormgpt.app>",
  "bugs": {
    "url": "https://github.com/wormgpt-app/wormagent/issues"
  },
  "engines": {
    "node": "22.x"
  }
}
